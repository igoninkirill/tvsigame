# HTTPS-фронт для «Своей Игры».
# DOMAIN подставляется из .env (compose передаёт его в окружение caddy).
# Caddy сам выпустит и будет продлевать сертификат Let's Encrypt,
# WebSocket (/ws/...) проксируется прозрачно, дополнительной настройки не нужно.

{$DOMAIN} {
	reverse_proxy app:8080

	# Медиа пакетов и загрузка .siq могут быть крупными.
	request_body {
		max_size 512MB
	}
}
